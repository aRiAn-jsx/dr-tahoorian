<% if (typeof content !== 'undefined' && content.Gallery && content.Gallery.length > 0) { %>
<section class="portfolio-section portfolio-showcase">
    <div class="portfolio-bg-grid" aria-hidden="true"></div>
    <div class="section-shell">
        <div class="portfolio-heading">
            <div>
                <span class="eyebrow">گالری همکاری‌ها</span>
                <h2>پروژه‌هایی که <em>داستان دارند</em></h2>
            </div>
            <p>هر پروژه، فصلی از مسیر ساختن است. از ایده تا اجرا، همراه شما بوده‌ایم.</p>
        </div>

        <div class="portfolio-stage" x-data="{ active: 0 }">
            <% content.Gallery.forEach(function(item, i) { %>
            <article class="portfolio-card portfolio-card--<%= i === 0 ? 'featured' : 'compact' %>"
                     @mouseenter="active = <%= i %>"
                     @click="active = <%= i %>"
                     :class="{ 'is-active': active === <%= i %> }">
                <div class="portfolio-visual">
                    <img src="<%= item.image_url %>" alt="<%= item.title %>" loading="lazy">
                    <div class="portfolio-shine"></div>
                </div>
                <div class="portfolio-info">
                    <span class="portfolio-number">۰<%= i + 1 %></span>
                    <span class="portfolio-tag"><%= item.category %></span>
                    <h3><%= item.title %></h3>
                    <p>برای مشاهده جزئیات پروژه، روی کارت کلیک کنید.</p>
                    <a href="/services" class="portfolio-link">مشاهده پروژه <i data-lucide="arrow-up-left"></i></a>
                </div>
            </article>
            <% }); %>
        </div>

        <div class="portfolio-progress">
            <div class="portfolio-progress__bar" x-bind:style="`width: ${((active + 1) / <%= content.Gallery.length %>) * 100}%`"></div>
        </div>
    </div>
</section>
<% } %>

<% if (typeof content !== 'undefined' && content.Stats && content.Stats.length > 0) { %>
<section class="stats-section">
    <div class="section-shell">
        <div class="stats-intro"><span class="eyebrow">در یک نگاه</span><h2>تجربه‌ای که<br><em>عدد دارد</em></h2></div>
        <div class="stats-grid">
            <% content.Stats.forEach(function(stat) { %>
            <div class="stat-item">
                <div class="stat-value" x-data="{ count: 0 }" x-init="let target = <%= stat.value %>; let step = Math.ceil(target / 50); let interval = setInterval(() => { if (count < target) { count += step } else { count = target; clearInterval(interval) } }, 30)">
                    <span x-text="count"><%= stat.value %></span><small><%= stat.suffix %></small>
                </div>
                <p><%= stat.label %></p>
            </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

