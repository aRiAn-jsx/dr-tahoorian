<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : 'دکتر حسین طهوریان — مرجع تخصصی طب سنتی و رگ‌گیری دستی، ثبت اختراع و نوآوری صنعتی، سرمایه‌گذاری هلدینگ و مشاوره تخصصی مدیریت سازمانی.' %>">
    <meta name="keywords" content="<%= typeof keywords !== 'undefined' && keywords ? keywords : 'طب سنتی, رگ گیری, رگ گیری طب سنتی, ثبت اختراع, آموزش ثبت اختراع, تسکین دردهای عضلانی, درمان اسپاسم, سرمایه گذاری هلدینگ, مشاوره تخصصی مدیریت, دکتر حسین طهوریان' %>">
    <meta name="author" content="دکتر حسین طهوریان">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <link rel="canonical" href="https://tahoorian.ir<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">

    <!-- OpenGraph / Social Sharing Cards -->
    <meta property="og:site_name" content="دکتر حسین طهوریان | وب‌سایت رسمی">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : 'خدمات تخصصی طب سنتی و رگ‌گیری، هدایت ثبت اختراع، سرمایه‌گذاری هلدینگ و مشاوره تخصصی مدیریت با دکتر حسین طهوریان.' %>">
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
    <meta property="og:url" content="https://tahoorian.ir<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
    <meta property="og:locale" content="fa_IR">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/static/images/download%20(1)-2.webp' %>">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= typeof description !== 'undefined' && description ? description : 'دکتر حسین طهوریان — طب سنتی و رگ‌گیری، ثبت اختراع، سرمایه‌گذاری و مشاوره تخصصی مدیریت' %>">
    <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/static/images/download%20(1)-2.webp' %>">

    <!-- Schema.org JSON-LD Structured Data (Medical & Professional) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://tahoorian.ir/#person",
          "name": "دکتر حسین طهوریان",
          "alternateName": "Dr. Hossein Tahoorian",
          "jobTitle": "پژوهشگر و درمانگر طب سنتی و رگ‌گیری، مخترع صنعتی، مشاور سرمایه‌گذاری و مدیریت هلدینگ",
          "description": "متخصص طب سنتی و فنون رگ‌گیری تخصصی، دارنده ۵ اختراع ثبت‌شده رسمی و مدال طلای مخترعان سوئیس، مشاور ارشد سرمایه‌گذاری و راهبری هلدینگ‌ها با ۲۰ سال تجربه.",
          "knowsAbout": [
            "طب سنتی و رگ‌گیری دستی",
            "آزادسازی نقاط ماشه‌ای و اسپاسم‌های عضلانی",
            "ثبت اختراع و تجاری‌سازی نوآوری صنعتی",
            "سرمایه‌گذاری خطرپذیر و معماری هلدینگ",
            "مشاوره تخصصی مدیریت و حاکمیت شرکتی"
          ]
        },
        {
          "@type": ["ProfessionalService", "MedicalBusiness"],
          "@id": "https://tahoorian.ir/#organization",
          "name": "مرکز تخصصی طب سنتی، نوآوری و مدیریت دکتر حسین طهوریان",
          "founder": { "@id": "https://tahoorian.ir/#person" },
          "description": "مرکز جامع ارائه خدمات طب سنتی و رگ‌گیری، مشاوره هدایت ثبت اختراع، توسعه سرمایه‌گذاری هلدینگ‌ها و مشاوره تخصصی مدیریت.",
          "address": {
            "@type": "PostalAddress",
            "addressCountry": "IR"
          },
          "areaServed": "IR",
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "پکیج‌های تخصصی دکتر طهوریان",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "پکیج سلامت، طب سنتی و رگ‌گیری تخصصی",
                  "description": "درمان دستی گرفتگی‌های اسکلتی-عضلانی، اصلاح گردش خون و تعدیل مزاج."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "پکیج سرمایه‌گذاری، مقیاس‌پذیری و توسعه هلدینگ",
                  "description": "مدل‌سازی مالی، جذب سرمایه‌گذار استراتژیک و معماری حاکمیت شرکتی."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "پکیج تجاری‌سازی نوآوری و ثبت اختراع",
                  "description": "نگارش فنی ادعانامه‌ها، استعلام FTO و پیگیری تا اخذ گواهینامه رسمی ثبت اختراع."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "پکیج مشاوره تخصصی مدیریت و عارضه‌یابی سازمانی",
                  "description": "عارضه‌یابی ۳۶۰ درجه، رفع گلوگاه‌های اجرایی و تدوین نقشه راه سودآوری."
                }
              }
            ]
          }
        }
      ]
    }
    </script>

    <link rel="icon" type="image/webp" href="/static/images/download%20(2).webp">
    <!-- Tailwind is loaded from CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="/static/vendor/js/alpine.min.js"></script>
    <script src="/static/vendor/js/htmx.min.js"></script>
    <script src="/static/vendor/js/lucide.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/style.css">
    <style>
        body { font-family: 'Vazirmatn', sans-serif; }
    </style>
</head>
<body class="bg-[#fbfbfd] text-[#17151d] antialiased" hx-boost="true" hx-target="#page-content" hx-select="#page-content" hx-swap="outerHTML">
    <div class="page-loader" aria-hidden="true"><span class="page-loader__dot"></span><span class="page-loader__dot"></span><span class="page-loader__dot"></span></div>
    <div id="toast-stack" class="toast-stack" aria-live="polite"></div>

    <!-- Liquid Glass SVG filter (used by glass buttons & cards via url(#lg-filter)) -->
    <svg width="0" height="0" style="position:absolute;" aria-hidden="true" focusable="false">
        <defs>
            <filter id="lg-filter" x="0%" y="0%" width="100%" height="100%">
                <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008"
                              numOctaves="2" seed="92" result="noise"/>
                <feGaussianBlur in="noise" stdDeviation="2" result="blurred"/>
                <feDisplacementMap in="SourceGraphic" in2="blurred" scale="20"
                                   xChannelSelector="R" yChannelSelector="G"/>
            </filter>
        </defs>
    </svg>

    <%- include('../partials/header') %>
    <main id="page-content">
        <%- body %>
    </main>
    <%- include('../partials/footer') %>
    <script src="/static/js/main.js"></script>
    <script>window.addEventListener('DOMContentLoaded', function () { if (window.lucide) lucide.createIcons(); });</script>
</body>
</html>
