<script>
(function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var revealEls = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
    if (revealEls.length && 'IntersectionObserver' in window && !reduceMotion) {
        var revealObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                revealObs.unobserve(entry.target);
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });

        revealEls.forEach(function (el) {
            el.classList.add('is-armed');
            revealObs.observe(el);
        });
    } else {
        revealEls.forEach(function (el) { el.classList.add('is-visible'); });
    }

    var orbs = Array.prototype.slice.call(document.querySelectorAll('.glass-orb[data-speed]'));
    var finePointer = !window.matchMedia || window.matchMedia('(pointer: fine)').matches;
    var targetX = 0, targetY = 0;
    var currentX = 0, currentY = 0;
    var scrollY = 0;
    var rafId = null;

    function renderOrbs() {
        currentX += (targetX - currentX) * 0.06;
        currentY += (targetY - currentY) * 0.06;

        orbs.forEach(function (orb, i) {
            var speed = parseFloat(orb.dataset.speed) || 0;
            var drift = scrollY * speed;
            var driftX = Math.sin(scrollY * 0.002 + i) * 14;
            var driftY = Math.cos(scrollY * 0.0016 + i) * 10;
            var depth = 6 + i * 5;
            var px = currentX * depth;
            var py = currentY * depth;

            orb.style.transform =
                'translate3d(' + (driftX + px) + 'px,' +
                (drift + driftY + py) + 'px,0)';
        });

        rafId = null;
    }

    function scheduleOrbs() {
        if (rafId === null) rafId = requestAnimationFrame(renderOrbs);
    }

    if (orbs.length && !reduceMotion && finePointer) {
        window.addEventListener('scroll', function () {
            scrollY = window.scrollY || window.pageYOffset || 0;
            scheduleOrbs();
        }, { passive: true });

        window.addEventListener('mousemove', function (e) {
            targetX = (e.clientX / window.innerWidth - 0.5) * 2;
            targetY = (e.clientY / window.innerHeight - 0.5) * 2;
            scheduleOrbs();
        }, { passive: true });

        scrollY = window.scrollY || 0;
        scheduleOrbs();
    }

    var counters = Array.prototype.slice.call(document.querySelectorAll('[data-count]'));
    if (counters.length && 'IntersectionObserver' in window && !reduceMotion) {
        var counterObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                animateCounter(entry.target);
                counterObs.unobserve(entry.target);
            });
        }, { threshold: 0.5 });

        counters.forEach(function (el) { counterObs.observe(el); });
    }

    function toPersianDigits(str) {
        var map = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
        return String(str).replace(/\d/g, function (d) { return map[+d]; });
    }

    function animateCounter(el) {
        var target = parseInt(el.getAttribute('data-count'), 10);
        if (isNaN(target)) return;
        var duration = 1400;
        var start = performance.now();

        function step(now) {
            var t = Math.min(1, (now - start) / duration);
            var eased = 1 - Math.pow(1 - t, 3);
            var value = Math.round(target * eased);
            el.textContent = toPersianDigits(value);
            if (t < 1) requestAnimationFrame(step);
            else el.textContent = toPersianDigits(target);
        }
        requestAnimationFrame(step);
    }

    function refreshLucide() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }
    }
    refreshLucide();

    if (document.readyState !== 'complete') {
        window.addEventListener('load', refreshLucide);
    }
})();
</script>
