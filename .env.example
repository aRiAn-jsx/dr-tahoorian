# Server
PORT=8080
ENV=development
# Database: "sqlite" (persistent) or "memory" (ephemeral)
DB_TYPE=sqlite
DB_DSN=tahoorian.db
# Sessions (must be a strong, random value in production)
SESSION_SECRET=change-me-in-production
# Admin panel credentials (override the dev defaults!)
ADMIN_USER=admin
ADMIN_PASS=admin

# --- Telegram notifications for the contact form (optional) ---
# Get a bot token from @BotFather, then find your Chat ID (e.g. via @userinfobot).
# Leave blank to disable forwarding contact form submissions to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
